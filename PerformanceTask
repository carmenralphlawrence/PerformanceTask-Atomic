        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            color: #7dd3fc;
        }


        /* ===== INTRO ===== */

        .intro {
            max-width: 900px;
            margin: 40px auto;
            padding: 30px;
            background-color: white;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 3px 12px rgba(0,0,0,0.1);
        }

        .intro h2 {
            color: #164e63;
        }

        .intro p {
            line-height: 1.8;
            color: #444;
        }


        /* ===== TIMELINE ===== */

        .timeline-section {
            max-width: 1100px;
            margin: auto;
            padding: 40px 20px;
        }

        .timeline-section h2 {
            text-align: center;
            color: #164e63;
            font-size: 32px;
            margin-bottom: 40px;
        }


        /* ===== SCIENTIST CARD ===== */

        .scientist {
            background-color: white;
            margin: 30px 0;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.12);
            border-left: 7px solid #2563eb;
            transition: 0.3s;
        }

        .scientist:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.18);
        }

        .card-content {
            display: flex;
            align-items: center;
            gap: 30px;
            padding: 25px;
        }


        /* ===== IMAGE ===== */

        .scientist img {
            width: 190px;
            height: 190px;
            object-fit: cover;
            border-radius: 12px;
            border: 4px solid #dbeafe;
        }


        /* ===== TEXT ===== */

        .text {
            flex: 1;
        }

        .number {
            color: #2563eb;
            font-weight: bold;
            font-size: 14px;
        }

        .text h3 {
            color: #164e63;
            font-size: 27px;
            margin: 7px 0;
        }

        .year {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .text p {
            line-height: 1.7;
            color: #444;
        }


        /* ===== BUTTON ===== */

        .read-btn {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 11px 20px;
            border-radius: 8px;
